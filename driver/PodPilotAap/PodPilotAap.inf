;
; PodPilotAap.inf - PodPilot AAP bridge (Bluetooth profile driver for AirPods and Beats)
;
; Loads on the AirPods' vendor service {4715650b-5e9d-4ac2-b898-a4fc0aa5df78} and opens
; Apple's AAP channel (L2CAP PSM 0x1001) for PodPilot.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Bluetooth
ClassGuid   = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider    = %ProviderName%
CatalogFile = PodPilotAap.cat
DriverVer   = 01/01/2026,0.1.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
PodPilotAap.sys = 1,,

[Manufacturer]
%ProviderName% = PodPilot,NT$ARCH$.10.0...16299

[PodPilot.NT$ARCH$.10.0...16299]
; Any device exposing the AAP service
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}
; Per model: VID 0x004C (Apple), PID = model id
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2002
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&200f
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2013
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2019
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&201b
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&200e
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2014
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2024
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2027
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&200a
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&201f
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2003
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2005
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&200d
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2010
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&200b
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&201d
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2011
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2012
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2016
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2026
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2006
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2009
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&200c
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2017
%AapDevice.DeviceDesc% = PodPilotAap_Device, BTHENUM\{4715650b-5e9d-4ac2-b898-a4fc0aa5df78}_VID&0001004c_PID&2025

[PodPilotAap_Device.NT]
CopyFiles = PodPilotAap_CopyFiles

[PodPilotAap_CopyFiles]
PodPilotAap.sys

[PodPilotAap_Device.NT.HW]
AddReg = PodPilotAap_Security

[PodPilotAap_Security]
; SYSTEM and Administrators full access, interactive users read/write (PodPilot runs as the user)
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[PodPilotAap_Device.NT.Services]
AddService = PodPilotAap, 0x00000002, PodPilotAap_Service

[PodPilotAap_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1               ; SERVICE_KERNEL_DRIVER
StartType     = 3               ; SERVICE_DEMAND_START
ErrorControl  = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\PodPilotAap.sys

[PodPilotAap_Device.NT.Wdf]
KmdfService = PodPilotAap, PodPilotAap_WdfSection

[PodPilotAap_WdfSection]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName         = "PodPilot"
DiskName             = "PodPilot AAP Installation Disk"
AapDevice.DeviceDesc = "PodPilot AAP Bridge"
ServiceDesc          = "PodPilot AAP Bridge Driver"
