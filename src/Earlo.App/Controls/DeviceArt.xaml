<UserControl x:Class="Earlo.App.Controls.DeviceArt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Simple vector drawings per form factor. No Apple artwork is used. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="200" Height="160">

            <!-- AirPods with long stems -->
            <Canvas x:Name="StemArt">
                <Canvas x:Name="StemPod">
                    <Path Data="M 54,18 C 32,18 22,36 27,53 C 31,67 45,72 58,67 L 59,138 C 59,148 75,148 75,138 L 77,45 C 77,28 70,18 54,18 Z"
                          Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                    <Ellipse Canvas.Left="33" Canvas.Top="34" Width="13" Height="19" Fill="{DynamicResource ArtShade}" />
                </Canvas>
                <Canvas RenderTransform="-1,0,0,1,200,0">
                    <Path Data="M 54,18 C 32,18 22,36 27,53 C 31,67 45,72 58,67 L 59,138 C 59,148 75,148 75,138 L 77,45 C 77,28 70,18 54,18 Z"
                          Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                    <Ellipse Canvas.Left="33" Canvas.Top="34" Width="13" Height="19" Fill="{DynamicResource ArtShade}" />
                </Canvas>
            </Canvas>

            <!-- AirPods Pro: short stem and ear tip -->
            <Canvas x:Name="ProArt">
                <Canvas>
                    <Ellipse Canvas.Left="14" Canvas.Top="40" Width="26" Height="32" Fill="{DynamicResource ArtShade}" />
                    <Path Data="M 54,26 C 32,26 24,46 29,62 C 34,76 48,80 60,75 L 61,124 C 61,133 77,133 77,124 L 79,54 C 79,36 71,26 54,26 Z"
                          Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                    <Rectangle Canvas.Left="64" Canvas.Top="92" Width="10" Height="14" RadiusX="4" RadiusY="4" Fill="{DynamicResource ArtShade}" />
                </Canvas>
                <Canvas RenderTransform="-1,0,0,1,200,0">
                    <Ellipse Canvas.Left="14" Canvas.Top="40" Width="26" Height="32" Fill="{DynamicResource ArtShade}" />
                    <Path Data="M 54,26 C 32,26 24,46 29,62 C 34,76 48,80 60,75 L 61,124 C 61,133 77,133 77,124 L 79,54 C 79,36 71,26 54,26 Z"
                          Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                    <Rectangle Canvas.Left="64" Canvas.Top="92" Width="10" Height="14" RadiusX="4" RadiusY="4" Fill="{DynamicResource ArtShade}" />
                </Canvas>
            </Canvas>

            <!-- Stemless buds -->
            <Canvas x:Name="RoundArt">
                <Ellipse Canvas.Left="20" Canvas.Top="46" Width="68" Height="68" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="38" Canvas.Top="64" Width="32" Height="32" Fill="{DynamicResource ArtShade}" />
                <Ellipse Canvas.Left="112" Canvas.Top="46" Width="68" Height="68" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="130" Canvas.Top="64" Width="32" Height="32" Fill="{DynamicResource ArtShade}" />
            </Canvas>

            <!-- Buds with ear hooks -->
            <Canvas x:Name="HookArt">
                <Path Data="M 38,78 C 14,48 26,14 58,14 C 82,14 92,34 86,56" Stroke="{DynamicResource ArtFill}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 38,78 C 14,48 26,14 58,14 C 82,14 92,34 86,56" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1" />
                <Ellipse Canvas.Left="30" Canvas.Top="66" Width="60" Height="60" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="46" Canvas.Top="82" Width="28" Height="28" Fill="{DynamicResource ArtShade}" />
                <Canvas RenderTransform="-1,0,0,1,200,0">
                    <Path Data="M 38,78 C 14,48 26,14 58,14 C 82,14 92,34 86,56" Stroke="{DynamicResource ArtFill}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M 38,78 C 14,48 26,14 58,14 C 82,14 92,34 86,56" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1" />
                    <Ellipse Canvas.Left="30" Canvas.Top="66" Width="60" Height="60" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                    <Ellipse Canvas.Left="46" Canvas.Top="82" Width="28" Height="28" Fill="{DynamicResource ArtShade}" />
                </Canvas>
            </Canvas>

            <!-- Over-ear / on-ear headphones -->
            <Canvas x:Name="HeadphonesArt">
                <Path Data="M 40,98 L 40,76 C 40,20 160,20 160,76 L 160,98" Stroke="{DynamicResource ArtStroke}" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 40,98 L 40,76 C 40,20 160,20 160,76 L 160,98" Stroke="{DynamicResource ArtFill}" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Rectangle Canvas.Left="16" Canvas.Top="82" Width="48" Height="68" RadiusX="20" RadiusY="20" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                <Rectangle Canvas.Left="52" Canvas.Top="92" Width="12" Height="48" RadiusX="5" RadiusY="5" Fill="{DynamicResource ArtShade}" />
                <Rectangle Canvas.Left="136" Canvas.Top="82" Width="48" Height="68" RadiusX="20" RadiusY="20" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                <Rectangle Canvas.Left="136" Canvas.Top="92" Width="12" Height="48" RadiusX="5" RadiusY="5" Fill="{DynamicResource ArtShade}" />
            </Canvas>

            <!-- Neckband / cable -->
            <Canvas x:Name="NeckbandArt">
                <Path Data="M 52,70 C 52,160 148,160 148,70" Stroke="{DynamicResource ArtStroke}" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="M 52,70 C 52,160 148,160 148,70" Stroke="{DynamicResource ArtFill}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Canvas.Left="30" Canvas.Top="30" Width="44" Height="44" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="126" Canvas.Top="30" Width="44" Height="44" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="1.5" />
            </Canvas>

            <!-- Charging case (used by the small icon variant) -->
            <Canvas x:Name="CaseArt">
                <Rectangle Canvas.Left="40" Canvas.Top="30" Width="120" Height="100" RadiusX="34" RadiusY="34" Fill="{DynamicResource ArtFill}" Stroke="{DynamicResource ArtStroke}" StrokeThickness="2" />
                <Line X1="42" Y1="62" X2="158" Y2="62" Stroke="{DynamicResource ArtStroke}" StrokeThickness="2" />
                <Ellipse Canvas.Left="96" Canvas.Top="82" Width="8" Height="8" Fill="{DynamicResource ArtShade}" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
