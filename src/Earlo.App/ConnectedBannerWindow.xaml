<Window x:Class="Earlo.App.ConnectedBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Earlo"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" IsHitTestVisible="False">
    <!-- A notification-style card in the top right corner, like the one a Mac shows when AirPods connect. -->
    <Border x:Name="Card" Margin="16" Padding="12,10,20,10" MinWidth="260" MaxWidth="380" CornerRadius="12"
            Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="56" Height="48" Margin="0,0,12,0" VerticalAlignment="Center">
                <Image x:Name="Render" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="Glyph" Text="&#xE7F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimary}" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse Width="7" Height="7" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{DynamicResource BatteryGood}" />
                    <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
