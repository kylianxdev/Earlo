<UserControl x:Class="PodPilot.App.Controls.PodStatusChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Chip" CornerRadius="12" Padding="10,7" Background="{DynamicResource SubtleFill}"
            BorderThickness="1" BorderBrush="Transparent">
        <StackPanel Orientation="Horizontal">
            <Grid Width="22" Height="26" VerticalAlignment="Center">
                <!-- Earbud (mirrored for the right side) -->
                <Path x:Name="Pod" Stretch="Uniform" Width="14" Height="24" StrokeThickness="1.2"
                      Data="M 8,0 C 3,0 0,3.5 0,8 C 0,12 3,14 6,13.5 L 6.5,28 C 6.5,30 10.5,30 10.5,28 L 11,9 C 11.5,3.5 11,0 8,0 Z"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="PodFlip" ScaleX="1" />
                    </Path.RenderTransform>
                </Path>
                <!-- Charging case -->
                <Border x:Name="CaseIcon" Width="22" Height="17" CornerRadius="6" BorderThickness="1.3" VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Height="1.3" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{Binding BorderBrush, ElementName=CaseIcon}" />
                </Border>
            </Grid>
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="SideText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock x:Name="StateText" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
