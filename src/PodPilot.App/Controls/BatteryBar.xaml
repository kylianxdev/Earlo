<UserControl x:Class="PodPilot.App.Controls.BatteryBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="30" Margin="0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="LabelText" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
            <!-- Where the earbud is: In ear / Out of ear / In case -->
            <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Margin="0,1,0,0" Visibility="Collapsed">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,1,5,0" />
                <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Border x:Name="Track" Grid.Column="1" Height="8" CornerRadius="4" VerticalAlignment="Center"
                Background="{DynamicResource BarTrack}" SizeChanged="OnTrackSizeChanged">
            <Border x:Name="Fill" CornerRadius="4" HorizontalAlignment="Left" Width="0" Background="{DynamicResource BatteryGood}" />
        </Border>

        <TextBlock x:Name="HintText" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

        <StackPanel x:Name="LevelPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="Bolt" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                       Margin="0,1,4,0" VerticalAlignment="Center" Foreground="{DynamicResource BatteryGood}" Visibility="Collapsed" />
            <TextBlock x:Name="PercentText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
        </StackPanel>
    </Grid>
</UserControl>
