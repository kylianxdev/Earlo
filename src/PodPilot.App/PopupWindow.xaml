<Window x:Class="PodPilot.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PodPilot.App.Controls"
        xmlns:app="clr-namespace:PodPilot.App"
        Title="PodPilot"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True">
    <Border x:Name="Card" Margin="20" Padding="20,16,20,16" CornerRadius="20"
            Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
            MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.30" />
        </Border.Effect>
        <Grid Width="340">
            <c:DevicePanel x:Name="Panel" Margin="0,0,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0">
                <Button x:Name="SettingsButton" Click="OnSettingsClick" ToolTip="{x:Static app:Strings.SettingsTip}" Style="{StaticResource IconButton}">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                </Button>
                <Button Click="OnCloseClick" ToolTip="{x:Static app:Strings.Close}" Style="{StaticResource IconButton}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
